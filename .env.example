# ==============================================================================
# CivicFix - Root Environment Configuration Template (.env.example)
# Copy this file or configure backend/.env and frontend/.env respectively.
# ==============================================================================

# Backend Database Credentials (MySQL 8.0+ / 9.0+)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=civicfix_db

# Backend Application Configuration
APP_HOST=127.0.0.1
APP_PORT=8000
SECRET_KEY=civicfix-production-secure-jwt-key-change-me

# Frontend Configuration
VITE_API_BASE_URL=/api
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
